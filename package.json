  "keywords": [
    "pi-package",
    "agent-skills",
    "pstack",
    "coding-agent",
    "developer-workflow",
    "engineering-workflow",
    "code-review",
    "debugging",
    "refactoring",
    "tdd",
    "verification",
    "orchestration",
    "claude-code",
    "codex",
    "opencode",
    "omp",
    "pi",
