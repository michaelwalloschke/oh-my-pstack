    "subagents"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JonathanPitre/oh-my-pstack.git"
  },
  "publishConfig": {
    "access": "public",
    "tag": "omp"
  },
  "pi": {
    "skills": [
      "./skills"
    ]
  },
  "files": [
    "skills",
    "agents",
    "scripts",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    ".claude-plugin",
    ".codex-plugin",
    ".agents/plugins",
    "upstream.lock.json",
    "assets",
    "docs/upstream-compatibility-design.md",
    "docs/installation.md",
    "docs/maintenance.md",
    "docs/fork-assessment-2026-10.md",
    "docs/upstream-refresh-2026-10-21.md",
    "CHANGES.md"
  ],
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "test:verify": "node --test scripts/verify.test.mjs",
    "test:sync": "node --test scripts/sync-upstream.test.mjs",
    "test:proposal": "node --test scripts/sync-proposal.test.mjs",
    "test:package": "node --test scripts/package.test.mjs",
    "test:omp-rpc": "node --test scripts/omp-rpc.test.mjs",
    "test:omp-provenance": "node --test scripts/omp-provenance.test.mjs",
    "smoke:omp": "node scripts/omp-smoke.mjs",
    "test:install": "node --test --test-concurrency=1 scripts/install.test.mjs",
    "sync:check": "node scripts/sync-upstream.mjs --check",
    "sync:apply": "node scripts/sync-upstream.mjs --apply",
    "sync:export-review": "node scripts/sync-upstream.mjs --export-review"
  }
